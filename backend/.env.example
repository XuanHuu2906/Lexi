# ── Lexi backend environment (template) ──────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# App
NODE_ENV=development
PORT=3000
# Frontend origin(s) allowed by CORS. Comma-separate for prod + Vercel previews,
# e.g. https://lexi.vercel.app,https://lexi-git-dev.vercel.app
# Leave as `*` only in development (credentials are disabled when `*`).
CORS_ORIGIN=http://localhost:3001

# Database (PostgreSQL — Neon or Supabase both work)
# DATABASE_URL: pooled connection (used at runtime). On Supabase this is the
# pooled `:6543` connection string.
DATABASE_URL="postgresql://user:password@host:5432/lexi?schema=public"
# DIRECT_URL: direct/session connection for `prisma migrate` (falls back to
# DATABASE_URL if unset). Use the non-pooled connection string here
# (Supabase `:5432`, or Neon's direct connection).
DIRECT_URL="postgresql://user:password@host:5432/lexi?schema=public"

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Short-lived access token (carried in the httpOnly `access_token` cookie).
JWT_ACCESS_EXPIRES=15m
# Refresh token lifetime in days (opaque token in `refresh_token` cookie; only
# its SHA-256 hash is stored server-side, and it rotates on every refresh).
JWT_REFRESH_EXPIRES_DAYS=30

# Azure Speech — Pronunciation Assessment (UC13). Leave blank to fall back to
# the LLM text-comparison scorer (front-end Web Speech recognition).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# AI provider (DeepSeek — OpenAI-compatible API)
AI_API_KEY=
# Base URL of the OpenAI-compatible provider (default: DeepSeek)
AI_BASE_URL=https://api.deepseek.com
# Model id (default: deepseek-chat; e.g. deepseek-reasoner)
AI_MODEL=deepseek-chat

# Email (Resend)
RESEND_KEY=
# Sender address (must be a Resend-verified domain in production)
EMAIL_FROM=Lexi <onboarding@resend.dev>

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lexi.app

# Redis (Upstash) — reminder job queue (BullMQ, UC18). Leave blank to disable
# the queue/worker (the app still boots).
# IMPORTANT: this MUST be the native Redis *TCP* connection string, NOT the
# Upstash REST URL/token. In the Upstash console open your database → Connect →
# choose "ioredis"/TCP and copy the `rediss://…:6379` URL.
REDIS_URL=
